# Copy this file to .env.local and fill in your own keys. .env.local is gitignored.

# Google Cloud → enable "Places API (New)" + "Geocoding API"
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# console.anthropic.com → used for outreach generation (claude-haiku-4-5)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Agent: Google Cloud → enable "PageSpeed Insights API" → API key. Free, 25k/day.
# Without it Google rate-limits anonymous calls and the speed check is skipped.
PAGESPEED_API_KEY=your_pagespeed_api_key_here

# Agent sending from your own Gmail. Needs 2-Step Verification on, then
# Google Account -> Security -> App passwords -> create one. Free.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Postal address shown under every email (required by US law for cold email; a PO box is fine).
POSTAL_ADDRESS="Your address, City, Postcode, Country"

# Optional phone alert on every reply (free): install the ntfy app, subscribe to
# a long random topic name, and put the same name here. Anyone who knows the
# name can read the alerts, so make it unguessable.
NTFY_TOPIC=

# Optional: free concept preview sites on Cloudflare Pages (see SETUP.md step 7).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Optional — hunter.io email enrichment (currently skipped; needs a professional email)
HUNTER_API_KEY=your_hunter_api_key_here

# Set to 1 to run the public demo (curated sample data, no API keys / no cost).
NEXT_PUBLIC_DEMO_MODE=0
